                                            <span className="material-symbols-outlined">neurology</span> 
                                            Creador de Reactivos
                                        </h3>
                                    </div>

                                    {/* Control Segmentado */}
                                    <div className="flex bg-surface-container rounded-lg p-1 mb-6 border border-outline-variant/30">
