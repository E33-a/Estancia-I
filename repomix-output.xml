                                        </button>
                                    </div>

                                    {/* Form Area */}
                                    <div className="flex flex-col gap-4 flex-grow">
                                        <div className="flex flex-col gap-1">
                                            <label className="font-label-lg text-label-lg text-on-surface font-medium">Pregunta / Instrucción</label>
                                            <textarea 
                                                value={question}
